// Cloudflare Pages configuration. wrangler.jsonc is the format Cloudflare
// recommends for new projects. Once a deploy uses this file it is the source
// of truth for these settings; the dashboard shows them read-only.
// Docs: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
//
// The scripts and workflows read the project name and output directory from
// here. Change pages_build_output_dir if the frontend framework changes.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "typhoon-replay",
  "pages_build_output_dir": "./web/dist",
  "compatibility_date": "2026-10-01",
  // Edge proxy settings (functions/api/[[path]].ts; edge/README.md). Values are strings, as in the dashboard.
  // BACKEND_ORIGINS maps impl -> origin; add node/rust/go here as they deploy. Unlisted impls answer 503
  // backend-not-deployed. STATIC_MODE "true" serves cached responses only: a manual emergency switch
  // (edge/README.md "Static mode"). The budget check (budget.yml) can also switch static mode on, through the
  // static_mode key of the EDGE_FLAGS KV binding below (read within a minute, no redeploy); it never switches it off.
  "vars": {
    "BACKEND_ORIGINS": "{\"java\":\"https://typhoon-replay-java.onrender.com\",\"go\":\"https://typhoon-replay-go.onrender.com\",\"node\":\"https://replay-api-node.krtmtthw.workers.dev\",\"rust\":\"https://replay-api-rust.krtmtthw.workers.dev\"}",
    "STATIC_MODE": "false",
    "ORIGIN_TIMEOUT_MS": "8000",
    "STALE_TIMEOUT_MS": "1500",
    "STALE_IF_ERROR_S": "604800",
    "RATE_LIMIT_PER_MINUTE": "120",
    "RATE_LIMIT_BURST": "60"
  },
  // Static-mode flag (key "static_mode": "true"/"false"), written by budget.yml and by hand. Top level, so production
  // and preview deployments both bind it (no "env" block here).
  "kv_namespaces": [{ "binding": "EDGE_FLAGS", "id": "102f06fc416a40e89d20800cb744d33f" }],
  // Service bindings to the backends that run as Workers (edge/src/proxy.ts upstreamFetch; DECISIONS "Edge routing").
  "services": [
    { "binding": "API_NODE", "service": "replay-api-node" },
    { "binding": "API_RUST", "service": "replay-api-rust" }
  ]
}
