{
  "name": "@typhoon-replay/contracts",
  "private": true,
  "type": "module",
  "description": "OpenAPI contract, database schema and conformance suite shared by every Replay backend.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "redocly lint source",
    "lint-dist": "redocly lint dist/openapi.json dist/openapi.3.0.json --extends minimal",
    "bundle": "node scripts/bundle.mjs",
    "check-examples": "node scripts/check-examples.mjs",
    "mock": "prism mock dist/openapi.json --host 0.0.0.0 --port 4010",
    "typecheck": "tsc -p conformance/tsconfig.json",
    "conformance": "vitest run --config conformance/vitest.config.ts",
    "compat-table": "node conformance/scripts/results-to-markdown.mjs"
  },
  "devDependencies": {
    "@apiture/openapi-down-convert": "0.14.2",
    "@redocly/cli": "2.71.0",
    "@stoplight/prism-cli": "5.16.0",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eventsource-parser": "4.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@scarf/scarf": false
  }
}
