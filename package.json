{
  "name": "typhoon-replay",
  "private": true,
  "description": "Deploy tooling for Replay (Cloudflare Pages). The app itself lives in web/.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "preview": "bash scripts/preview.sh",
    "ci": "bash scripts/ci.sh",
    "test:edge": "tsc -p edge && vitest run --root edge",
    "deploy:preview": "bash scripts/deploy.sh --preview",
    "deploy:production": "bash scripts/deploy.sh --production"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261026.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true,
    "fsevents": false
  }
}
