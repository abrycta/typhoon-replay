# Frontend build settings, shared by scripts/*.sh and .github/workflows/*.yml.
# Sourced by bash: plain KEY="value" lines only.
#
# Switching frontend frameworks means editing this file plus
# pages_build_output_dir in wrangler.jsonc (which also holds the Pages project
# name). Commands run inside APP_DIR.

# Directory of the frontend app, relative to the repo root.
APP_DIR="web"
# Clean, lockfile-exact dependency install.
APP_INSTALL="npm ci"
# Static checks and unit tests (run in CI and before a manual deploy).
APP_CHECKS="npm run typecheck && npm run lint && npm run test"
# Production build; must write to pages_build_output_dir in wrangler.jsonc.
APP_BUILD="npm run build"
# Dev server; scripts/dev.sh appends --host and any extra args.
APP_DEV="npm run dev --"
# Fallback static server for scripts/preview.sh when wrangler can't run.
APP_PREVIEW="npm run preview --"
