# Copy to .env.deploy (gitignored) for scripts/deploy.sh. Variables already set
# in your shell take precedence. Never commit real values.
#
# API token: Cloudflare dashboard > My Profile > API Tokens > Create Token >
#   Custom token, permission Account / Cloudflare Pages / Edit.
CLOUDFLARE_API_TOKEN=
# Account ID: Cloudflare dashboard > Workers & Pages (right-hand sidebar),
#   or the 32-character hex string in the dashboard URL.
CLOUDFLARE_ACCOUNT_ID=
