{
  "name": "typhoon-replay-web",
  "private": true,
  "version": "0.2.0",
  "description": "Replay web app: a static-first SPA (Stack A, docs/architecture/DECISIONS.md).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/bundle-data.mjs && node scripts/stamp-shells.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "preview": "vite preview",
    "perf": "node scripts/measure-load.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "i18n:extract": "lingui extract --clean",
    "fixtures": "uv run --project ../pipeline python scripts/make_fixtures.py",
    "size": "node scripts/report-size.mjs"
  },
  "dependencies": {
    "@abrycta/akari": "^0.14.0",
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "comlink": "^4.4.2",
    "lucide-react": "^1.60.0",
    "maplibre-gl": "^6.15.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.10.0",
    "@lingui/cli": "^6.10.0",
    "@lingui/format-po": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-msw": "^2.1.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "msw": false,
    "@scarf/scarf": false
  }
}
