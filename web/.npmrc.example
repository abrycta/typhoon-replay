# Copy to web/.npmrc (gitignored) once the app depends on @abrycta/akari.
# The token is read from the environment, never written here:
#   export NODE_AUTH_TOKEN=<classic GitHub PAT with read:packages>
# In GitHub Actions, actions/setup-node writes the same settings and
# NODE_AUTH_TOKEN comes from GITHUB_TOKEN (permissions: packages: read).
@abrycta:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
