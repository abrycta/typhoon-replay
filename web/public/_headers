# Cloudflare Pages response headers (also applied by `wrangler pages dev`).
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
# Note: when several rules match, values of the same header are joined with a
# comma, so Cache-Control is set only on non-overlapping paths below.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Data: the Hugging Face dataset (resolve URLs redirect to *.hf.co); basemap: OpenFreeMap (style, tiles,
  # glyphs, sprites). 'wasm-unsafe-eval' is kept for a later DuckDB-WASM page. Add new hosts to connect-src.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://tiles.openfreemap.org; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Vite emits content-hashed file names here, so they never change in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The frozen embed krtmtthw.dev frames (src/embed): only that site may frame it, and it fetches nothing off this
# origin. Detach the global X-Frame-Options and CSP, then set the CSP again with connect-src 'self' and
# frame-ancestors https://krtmtthw.dev. The HTML names hashed files, so it always revalidates.
/embed/*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors https://krtmtthw.dev; base-uri 'self'; object-src 'none'
  Cache-Control: public, max-age=0, must-revalidate

# The embed's packed data and baked basemap (scripts/build-embed.mjs): content-hashed names, never changed in place.
/embed-data/*
  Cache-Control: public, max-age=31536000, immutable

# Bundled sample dataset (fallback while the published dataset is unreachable). Stable names, so a short TTL.
/fixtures/*
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

# Runtime configuration: hosts and backends change without a rebuild.
/config.json
  Cache-Control: public, max-age=0, must-revalidate

# Per-storm share shells (stamped at build time from the storm index).
/storm/*
  Cache-Control: public, max-age=0, must-revalidate

# Akari's pre-paint theme script (stable name, render-blocking): short TTL so upgrades land quickly.
/theme-init.js
  Cache-Control: public, max-age=300

# The pre-paint language script (stable name, render-blocking): same short TTL.
/lang-init.js
  Cache-Control: public, max-age=300

# The HTML entry point must always revalidate so new deploys show up at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
